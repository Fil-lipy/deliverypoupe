# ====== Delivery Poupefarma — variáveis de ambiente ======
# Copie para .env (local) e configure no painel da Vercel (Settings > Environment Variables).
# NUNCA commite o .env com valores reais.

# --- Banco do app (Prisma): usuários, carrinhos, banners, configs ---
# Runtime (pooler pgbouncer, porta 6543). Ex.: Supabase > Connect > "Transaction pooler" + ?pgbouncer=true
DATABASE_URL=
# Migrações/db push (conexão direta, porta 5432). Ex.: Supabase > Connect > "Direct connection"
DATABASE_DIRECT_URL=

# --- Supabase Hub (catálogo + pedidos): mesma string pooler que o lib/supabase-db.ts usa ---
SUPABASE_DATABASE_URL=

# --- NextAuth ---
NEXTAUTH_SECRET=        # gere: openssl rand -base64 32
NEXTAUTH_URL=           # URL do deploy, ex.: https://deliverypoupe.vercel.app

# --- Asaas (pagamento Pix/cartão) ---
ASAAS_API_KEY=          # sandbox: aact_hmlg_... | produção: aact_prod_... (entre aspas por causa do $)
ASAAS_BASE_URL=https://api-sandbox.asaas.com/v3
ASAAS_WEBHOOK_TOKEN=    # token que você define no painel do Asaas para o webhook

# --- Receita (foto) — Supabase Storage (bucket privado) ---
RECEITAS_BUCKET=receitas-delivery

# --- AWS S3 (OPCIONAL — só upload de imagem de produto no admin) ---
# Deixe em branco se não for usar. Sem isso, o catálogo funciona (imagens vêm do Supabase).
AWS_REGION=
AWS_BUCKET_NAME=
AWS_FOLDER_PREFIX=
